# =============================================================================
# T.N. Memorial Public School Digital Platform
# Dockerfile.nginx — Nginx Reverse Proxy
# =============================================================================

FROM nginx:stable-alpine

LABEL maintainer="T.N. Memorial School Platform Team"
LABEL description="Nginx reverse proxy for TNM School Digital Platform"
LABEL version="1.0.0"

RUN rm -f /etc/nginx/conf.d/default.conf \
    && rm -f /etc/nginx/nginx.conf

COPY deployment/docker/nginx/nginx.conf /etc/nginx/nginx.conf

RUN mkdir -p /var/cache/nginx \
    && mkdir -p /var/log/nginx \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

